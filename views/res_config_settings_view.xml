<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sales_config" model="ir.ui.view">
        <field name="name">sale settings (sale_invoice_policy_extended)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[field[@name='default_invoice_policy']]"
                position="after"
            >
                <setting
                    id="sale_invoice_policy_setting"
                    string="Sale Invoice Policy"
                    help="Make Invoice Policy required on Sale Orders"
                >
                    <field name="sale_invoice_policy_required" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
